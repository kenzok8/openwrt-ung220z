+def _fail(code, error):
+    """[luci-patch] Failure exit: print a JSON error object on stdout in JSON
+    mode, stay silent otherwise. Returns the exit code."""
+    if _json_mode:
+        print(json.dumps({"ok": False, "code": code, "error": error},
+                         ensure_ascii=False), flush=True)
+    return code
+
+
+def _json_ok(payload):
+    """[luci-patch] Success exit: print exactly one JSON object on stdout."""
+    payload["ok"] = True
+    print(json.dumps(payload, ensure_ascii=False), flush=True)
+
