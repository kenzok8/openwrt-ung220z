+def probe_info(ip):
+    """[luci-patch] Probe the fingerprint, return structured info (for --probe / LuCI)."""
+    info = {"ip": ip, "reachable": False, "server": "-", "title": "-", "hits": []}
+    try:
+        req = urllib.request.Request("http://%s/" % ip,
+                                     headers={"User-Agent": "Mozilla/5.0 Chrome/120"})
+        with urllib.request.urlopen(req, timeout=6) as r:
+            info["reachable"] = True
+            info["server"] = r.headers.get("Server", "-")
+            body = _decode(r.read(), r.headers.get("Content-Type", ""))
+        m = re.search(r"<title>([^<]*)</title>", body, re.I)
+        if m:
+            info["title"] = m.group(1).strip()
+        low = body.lower()
+        info["hits"] = [name for key, name in MARKERS if key in low]
+    except Exception as e:
+        info["error"] = "%s: %s" % (e.__class__.__name__, e)
+    return info
+
