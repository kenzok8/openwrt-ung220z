+def _obtain_credentials(a):
+    """[luci-patch] Gather (ip, user, password).
+
+    Interactive mode prompts exactly as upstream does. In --json mode it
+    never prompts: the password comes from --password-file (preferred; the
+    file is removed after being read) or -p. Returns (ip, user, pw); pw
+    is None when no password could be obtained.
+    """
+    if _json_mode:
+        ip = (a.ip or "").strip() or "192.168.1.1"
+        user = (a.user or "").strip() or "user"
+        pw = None
+        if a.password_file:
+            try:
+                with open(a.password_file, "r", encoding="utf-8") as f:
+                    pw = f.read().rstrip("\r\n")
+                try:
+                    os.unlink(a.password_file)
+                except OSError:
+                    pass
+            except OSError as e:
+                log("WARN", "读密码文件失败：%s" % e)
+        elif a.password:
+            pw = a.password.rstrip("\r\n")
+        return (ip, user, pw)
+    print()
+    print("  ※ 用户名和密码通常印在光猫【背面贴纸】上（S/N 标签）")
+    print("    形如「用户名：user   密码：xxxxxxxx」，把光猫翻过来就能看到")
+    print(flush=True)
+    ip = (a.ip or "").strip() or input("① 光猫地址 [192.168.1.1]: ").strip() or "192.168.1.1"
+    user = (a.user or "").strip() or input("② 用户名 [user]: ").strip() or "user"
+    if a.password:
+        pw = a.password.rstrip("\r\n")          # 首尾空格可能是口令的一部分
+    else:
+        print("③ 密码（输入时不显示）", flush=True)
+        if sys.stdin.isatty() and getpass is not None:
+            pw = getpass.getpass("   密码: ").rstrip("\r\n")
+        else:
+            pw = input("   密码: ").rstrip("\r\n")
+    return (ip, user, pw)
+
